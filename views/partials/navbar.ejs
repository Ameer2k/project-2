<% if (user) { %>
  <nav class="sidebar" aria-label="Main navigation">
    <a class="sidebar-logo" href="/" aria-label="Frame home">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M4 10h6l2-3h8l2 3h6v15H4z" />
        <circle cx="16" cy="17" r="5" />
        <circle cx="25" cy="13" r="1" />
      </svg>
      <span class="nav-label">Frame</span>
    </a>

    <div class="sidebar-links">
      <% if (page === "home") { %>
        <a
          class="nav-item"
          type="button"
          id="show-listings"
          aria-label="Listings"
          aria-pressed="true"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          <span class="nav-label">Listings</span>
        </a>

        <a
          class="nav-item"
          type="button"
          id="show-blogs"
          aria-label="Blogs"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" />
          </svg>
          <span class="nav-label">Blogs</span>
        </a>
      <% } else { %>
        <a class="nav-item" href="/#listings" aria-label="Listings">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          <span class="nav-label">Listings</span>
        </a>

        <a class="nav-item" href="/#blogs" aria-label="Blogs">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" />
          </svg>
          <span class="nav-label">Blogs</span>
        </a>
      <% } %>

      <% if (user.role === "user") { %>
        <a class="nav-item" href="/cart" aria-label="Cart">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 4h2l2.2 11h10.9L21 8H6M9 20h.01M17 20h.01" />
          </svg>
          <span class="nav-label">Cart</span>
        </a>
      <% } %>

      <a
        class="nav-item"
        href="<%= user.role === "photographer" ? "/listings/new" : "/blogs/new" %>"
        aria-label="<%= user.role === "photographer" ? "Create listing" : "Create blog" %>"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        <span class="nav-label">
          <%= user.role === "photographer" ? "Create listing" : "Create blog" %>
        </span>
      </a>

      <a class="nav-item" href="/auth/profile" aria-label="Profile">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21a8 8 0 0 1 16 0" />
        </svg>
        <span class="nav-label">Profile</span>
      </a>
    </div>

    <div class="sidebar-bottom">
      <form action="/auth/sign-out" method="post">
        <button class="nav-item" type="submit" aria-label="Sign out">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10" />
          </svg>
          <span class="nav-label">Sign out</span>
        </button>
      </form>
    </div>
  </nav>
<% } else { %>
  <nav class="guest-nav" aria-label="Main navigation">
    <a class="logo" href="/" aria-label="Frame home">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M4 10h6l2-3h8l2 3h6v15H4z" />
        <circle cx="16" cy="17" r="5" />
        <circle class="logo-lens" cx="25" cy="13" r="1" />
      </svg>
      <span>Frame<span>.</span></span>
    </a>
    <div>
      <a href="/auth/sign-in">Sign in</a>
      <a class="button" href="/auth/sign-up">Sign up</a>
    </div>
  </nav>
<% } %>

<% if (typeof toastMessage !== "undefined" && toastMessage) { %>
  <div id="app-toast" class="toast" role="status" aria-live="polite">
    <span><%= toastMessage %></span>
    <button class="toast-close" type="button" aria-label="Close">×</button>
  </div>
<% } %>
