<% if (user) { %>
    <nav>
    <a href="/">Frame</a>

        <% if (page === 'home') { %>
      <button type="button" id="show-listings" aria-pressed="true">Listings</button>
      <button type="button" id="show-blogs" aria-pressed="false">Blogs</button>
    <% } else { %>
      <a href="/#listings">Listings</a>
      <a href="/#blogs">Blogs</a>
    <% } %>

    <% if (user.role === 'user') { %>
      <a href="/cart">Cart</a>
    <% } %>

        <a href="<%= user.role === 'photographer' ? '/listings/new' : '/blogs/new' %>"><%= user.role === 'photographer' ? 'Create listing' : 'Create blog' %></a>
    <a href="/auth/profile">Profile</a>

    <form action="/auth/sign-out" method="post" style="display: inline">
      <button type="submit">Sign out</button>
    </form>
  </nav>
  <hr />
<% } else { %>
    <nav>
    <a href="/">Frame</a>
    <a href="/auth/sign-in">Sign in</a>
    <a href="/auth/sign-up">Sign up</a>
  </nav>
  <hr />
<% } %>
