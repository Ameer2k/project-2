<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>All Listings</h1>

    <% for(let oneListing of listings){ %>
        <div>
            <div>image: <img src="<%= oneListing.image %>" alt="<%= oneListing.title %>"></div>
            <h2><%= oneListing.title %></h2>
            <p>by <%= oneListing.owner.username %></p>
            <p><%= oneListing.description %></p>
            <p>Price: $<%= oneListing.price %></p>
            <form action="/cart/add/<%= oneListing._id %>" method="post">
                <button>add to cart</button>
            </form>
            <form action="/favorites/add/<%= oneListing._id %>" method="post">
                <button>add to favorites</button>
            </form>
        </div>
    <% } %>
</body>
</html>