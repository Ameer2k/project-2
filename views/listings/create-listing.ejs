<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Listing</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <script src="/js/app.js" defer></script>
  </head>
  <body class="<%= user ? 'member-page' : 'guest-page' %>">
        <%- include('../partials/navbar', { page: 'other' }) %>
    <main class="form-page">
      <h1>Create Listing</h1>
            <form action="/listings" method="post" enctype="multipart/form-data">
        <div>
          <label for="title">Package title</label>
          <input type="text" id="title" name="title" required />
        </div>
                <div>
          <label for="image">Package photos</label>
          <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp" multiple required />
        </div>
        <div>
          <label for="description">Description</label>
          <textarea id="description" name="description" required></textarea>
        </div>
        <div>
          <label for="price">Price ($)</label>
          <input type="number" id="price" name="price" min="0" step="0.01" required />
        </div>
        <button type="submit">Create Listing Package</button>
      </form>
            <a href="/auth/profile">Back to profile</a>
    </main>
  </body>
</html>
