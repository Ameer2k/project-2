<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Listing Details</h1>


    <p>Listing at <%= listing.name %> by <%= listing.owner.username %></p>
    <p>Package Name: <%= listing.name %></p>
    <p>Description: <%= listing.description %></p>
    <p>Price: $<%= listing.price %></p>

    <% if(listing.owner._id.equals(user._id)) { %>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button>Delete Listing</button>
        </form>
    <% } %>

    <br>
     <p>Favorited by <%= listing.favoritedByUsers.length %> People</p>

     <% const isFavorited = listing.favoritedByUsers.find((oneFavoriteId)=>oneFavoriteId.equals(user._id)) %>

     <% if(isFavorited){ %>
        <form action="/listings/<%= listing._id %>/unfavorite" method="post">
            <button>Unfavorite</button>
        </form>
    <% }else{ %>
        <form action="/listings/<%= listing._id %>/favorite" method="post">
            <button>Favorite</button>
        </form>
     <% } %>

     


    
</body>
</html>