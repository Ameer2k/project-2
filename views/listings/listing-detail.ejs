<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= listing.title %></h1>
      <article>
        <p><%= listing.description %></p>
        <p>$<%= listing.price %></p>
        <% if (listing.owner) { %>
          <p>Photographer: <a href="/profiles/<%= listing.owner._id %>"><%= listing.owner.username %></a></p>
        <% } %>

        <p>Saved by <%= listing.favBy.length %> members.</p>

        <!-- here i should complete the favorte from when i add the route for now just the form without action -->
        <form action="" method="post">

          <input type="" name="" />
          <button type="submit"></button>

        </form>

        <!-- here i should complete the add to cart from when i add the route for now just the form without action -->
        <% if (user.role === 'user') { %>
          <form action="" method="post">

            <input type="" name="" />
            <button type="submit">Add to cart</button>

          </form>
        <% } %>

        <% if (listing.owner && listing.owner._id.equals(user._id)) { %>

          <a href="/listings/<%= listing._id %>/edit">Edit listing</a>

          <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button type="submit">Delete listing</button>
          </form>
        <% } %>
      </article>
      
      <a href="/">Back to home</a>
    
</body>
</html>