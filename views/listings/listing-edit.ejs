<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Listing</title>
        <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/app.js" defer></script>
  </head>
  <body class="<%= user ? 'member-page' : 'guest-page' %>">
        <%- include('../partials/navbar', { page: 'other' }) %>
    <main class="form-page">
      <h1>Edit Listing</h1>
            <form action="/listings/<%= listing._id %>?_method=PUT" method="post" enctype="multipart/form-data">
        <div>
          <label for="title">Package title</label>
          <input type="text" id="title" name="title" required value="<%= listing.title %>" />
        </div>
                <fieldset class="edit-media">
          <legend>Current photos and videos</legend>
          <div class="edit-media-grid">
            <% for (let file of (listing.media && listing.media.length ? listing.media : [{ url: listing.image, type: 'image' }])) { %>
              <div>
                <% if (file.type === 'video') { %>
                  <video src="<%= file.url %>" controls preload="metadata"></video>
                <% } else { %>
                  <img src="<%= file.url %>" alt="Package photo" />
                <% } %>
                <label><input type="checkbox" name="removeMedia" value="<%= file._id || 'legacy-image' %>" /> Remove</label>
              </div>
            <% } %>
          </div>
        </fieldset>
        <div>
          <label for="image">Add more photos or videos</label>
          <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp,.mp4,.webm" multiple />
          <small>Leave empty to keep the current files. Maximum 10 files in total, 25 MB each.</small>
        </div>
        <div>
          <label for="description">Description</label>
          <textarea id="description" name="description" required><%= listing.description %></textarea>
        </div>
        <div>
          <label for="price">Price ($)</label>
          <input type="number" id="price" name="price" min="0" step="0.01" required value="<%= listing.price %>" />
        </div>
        <button type="submit">Save changes</button>
      </form>
            <a href="/auth/profile">Back to profile</a>
    </main>
  </body>
</html>
