<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Listing</title>
  </head>
  <body>
      <h1>Edit Listing</h1>
      <form action="/listings/<%= listing._id %>?_method=PUT" method="post">
        <div>
          <label for="title">Package title</label>
          <input type="text" id="title" name="title" required value="<%= listing.title %>" />
        </div>
        <div>
          <label for="image">Package image URL</label>
          <input type="url" id="image" name="image" required value="<%= listing.image %>" />
        </div>
        
        <div>
          <label for="description">Description</label>
          <textarea id="description" name="description" required><%= listing.description %></textarea>
        </div>

        <div>
          <label for="price">Price ($)</label>
          <input type="number" id="price" name="price" required value="<%= listing.price %>" />
        </div>

        <button type="submit">Save changes</button>
      </form>

      <a href="/auth/profile">Back to profile</a>
  </body>
</html>
