<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>

    <article class="post">

        <h1><%= blog.title %></h1>
        <% if (blog.owner) { %>
          <p>By <a href="/profiles/<%= blog.owner._id %>"><%= blog.owner.username %></a></p>
        <% } %>
        <% if (blog.listing) { %>
          <img src="<%= blog.listing.image %>" alt="<%= blog.listing.title %>" />
          <a href="/listings/<%= blog.listing._id %>">View <%= blog.listing.title %></a>
        <% } else { %>
          <p>The original listing was deleted.</p>
        <% } %>
        <p><%= blog.content %></p>

        <form action="/blogs/<%= blog._id %>/favorite" method="post">
          <input type="hidden" name="back" value="/blogs/<%= blog._id %>" />
          <button type="submit"><%= blog.favBy.includes(user._id) ? 'Remove favorite' : 'Add favorite' %></button>
        </form>

        <% if (blog.owner && blog.owner._id.equals(user._id)) { %>
          <a href="/blogs/<%= blog._id %>/edit">Edit blog</a>

          <form action="/blogs/<%= blog._id %>?_method=DELETE" method="post">
            <button type="submit">Delete blog</button>
          </form>

        <% } %>
      </article>
      <a href="/#blogs">Back to home blogs</a>
  </body>
</html>
