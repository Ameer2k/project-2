<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Blog</title>
    <link rel="stylesheet" href="/css/base.css" />
  </head>
  <body>
    <%- include('../partials/navbar', { page: 'other' }) %>
    <main>
      <h1>Edit Blog</h1>
      
      <form action="/blogs/<%= blog._id %>?_method=PUT" method="post">
      
        <label for="title">Blog title</label>
        <input type="text" id="title" name="title" required value="<%= blog.title %>" />
      
        <label for="content">Your opinion / experience</label>
        <textarea id="content" name="content" required><%= blog.content %></textarea>
      
        <button type="submit">Save changes</button>
      
      </form>
      <a href="/auth/profile">Back to profile</a>
    </main>
  </body>
</html>
