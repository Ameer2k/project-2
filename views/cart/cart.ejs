<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart</title>
  </head>
  <body>
    <h1>My Cart</h1>
    <p>Your cart is currently empty.</p>
    <% for (let cartItem of cartItems) { %>
      <p>Item: <%= cartItem.name %></p>
      <p>Price: $<%= cartItem.price %></p>
      <% const element = array[index]; %>
    <% } %>
  </body>
</html>
