<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>profile</title>
  </head>
  <body>
      <header>

        <img src="<%= profile.profilePicture %>" alt="Profile photo" />
        
        <div>
        
          <h1><%= profile.username %></h1>
        
          <% if (ownProfile) { %>
            <a href="/profiles/me/edit">Edit profile</a>
        
            <% } else { %>
        
              <form action="/profiles/<%= profile._id %>/follow" method="post">
              <button type="submit"><%= isFollowing ? 'Unfollow' : 'Follow' %></button>
            </form>
        
            <% } %>
        
          </div>

        <div>
        
          <span><strong><%= listings.length + blogs.length %></strong> posts</span>
        
          <% if (ownProfile) { %>
        
            <button type="button" id="open-followers"><strong><%= followers %></strong> followers</button>
            <button type="button" id="open-following"><strong><%= profile.following.length %></strong> following</button>
        
            <% } else { %>
        
              <span><strong><%= followers %></strong> followers</span>
            <span><strong><%= profile.following.length %></strong> following</span>
        
            <% } %>
        
          </div>
        
        <strong><%= profile.firstName %> <%= profile.lastName %></strong>
        <p><%= profile.role %></p>
        <p><%= profile.bio %></p>
      </header>

      <% if (ownProfile) { %>
      
        <dialog id="followers-dialog">
      
          <header>
      
            <h2>Followers</h2>
            <button type="button" id="close-followers">×</button>
      
          </header>
      
          <div>
      
            <% if (!followerUsers.length) { %>
              <p>No followers yet.</p>
            <% } %>
      
            <% for (let person of followerUsers) { %>
              <a href="/profiles/<%= person._id %>">
              <img class="avatar" src="<%= person.profilePicture %>" alt="" />
              <span><strong><%= person.username %></strong><small><%= person.firstName %> <%= person.lastName %></small></span>
              <span>View profile</span>
              </a>
      
            <% } %>
    
          </div>
    
        </dialog>

        <dialog id="following-dialog">
    
          <header>
            <h2>Following</h2>
            <button type="button" id="close-following">×</button>
          </header>
    
          <div>
    
            <% if (!followingUsers.length) { %>
              <p>You are not following anyone yet.</p>
            <% } %>
    
            <% for (let person of followingUsers) { %>
              <a href="/profiles/<%= person._id %>">
              <img class="avatar" src="<%= person.profilePicture %>" />
              <span><strong><%= person.username %></strong><small><%= person.firstName %> <%= person.lastName %></small></span>
              <span>View profile</span>
              </a>
            <% } %>
    
          </div>
    
        </dialog>
    
        <% } %>

      <% 
        let tabClass = '';
        if (!ownProfile) {
          tabClass = 'single-tab';
        } else if (user.role !== 'user') {
          tabClass = 'two-tabs';
        }
      %>

      <div class="<%= tabClass %>" id="profile-tabs" data-active="posts">
        <button type="button" id="show-posts">Posts</button>
          
        <% if (ownProfile) { %>
            <button type="button" id="show-favorites">Favorites</button>
          <% if (user.role === 'user') { %>
            <button type="button" id="show-history">Cart history</button>
          <% } %>
        <% } %>
     
      </div>

      <section id="profile-posts">
        <% if (!listings.length && !blogs.length) { %>
          <div><h2>No posts yet</h2><p>Your published work will appear here.</p></div>
        <% } %>
        <div>
          
          <!-- Listings Loop Inline -->
          <% for (let listing of listings) { %>
            <article>
              <a href="/listings/<%= listing._id %>">
                <% if (listing.image) { %>
                  <img src="<%= listing.image %>" />
                <% } else { %>
                  <div>
                    <span>JOURNAL</span>
                    <h2><%= listing.title %></h2>
                  </div>
                <% } %>
                <h3><%= listing.title %></h3>
              </a>

              <% if (ownProfile) { %>
                <div>
                  <a href="/listings/<%= listing._id %>/edit">Edit</a>
                  <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                    <button type="submit">Delete</button>
                  </form>
                </div>
              <% } %>
            </article>
          <% } %>

          <% for (let blog of blogs) { %>
            <article>
              <a href="/blogs/<%= blog._id %>">
                <% if (blog.listing ? blog.listing.image : null) { %>
                  <img src="<%= blog.listing.image %>" alt="<%= blog.title %>" />
                <% } else { %>
                  <div>
                    <span>JOURNAL</span>
                    <h2><%= blog.title %></h2>
                  </div>
                <% } %>
                <h3><%= blog.title %></h3>
              </a>

              <% if (ownProfile) { %>
                <div>
                  <a href="/blogs/<%= blog._id %>/edit">Edit</a>
                  <form action="/blogs/<%= blog._id %>?_method=DELETE" method="post">
                    <button type="submit">Delete</button>
                  </form>
                </div>
              <% } %>
            </article>
          <% } %>

        </div>
      </section>


      <% if (ownProfile) { %>

      <section id="profile-favorites" hidden>
        <% if (!favorites.length && !favoriteBlogs.length) { %>
          <div><h2>Save what inspires you</h2><p>Your favorite posts will appear here.</p></div>
        <% } %>
        
        <div>

          <% for (let listing of favorites) { %>
            <article>
              <a href="/listings/<%= listing._id %>">
                <% if (listing.image) { %>
                  <img src="<%= listing.image %>" alt="<%= listing.title %>" />
                <% } else { %>
                  <div>
                    <span>JOURNAL</span>
                    <h2><%= listing.title %></h2>
                  </div>
                <% } %>
                <h3><%= listing.title %></h3>
              </a>

              <form action="/listings/<%= listing._id %>/favorite" method="post">
                <input type="hidden" name="back" value="/auth/profile#favorites" />
                <button type="submit" aria-label="Remove from favorites">♥</button>
              </form>
            </article>
          <% } %>

          <% for (let blog of favoriteBlogs) { %>
            <article>
              <a href="/blogs/<%= blog._id %>">
                <% if (blog.listing ? blog.listing.image : null) { %>
                  <img src="<%= blog.listing.image %>" alt="<%= blog.title %>" />
                <% } else { %>
                  <div>
                    <span>JOURNAL</span>
                    <h2><%= blog.title %></h2>
                  </div>
                <% } %>
                <h3><%= blog.title %></h3>
              </a>

              <form action="/blogs/<%= blog._id %>/favorite" method="post">
                <input type="hidden" name="back" value="/auth/profile#favorites" />
                <button type="submit" aria-label="Remove from favorites">♥</button>
              </form>

            </article>
          <% } %>
        </div>
      </section>



        <% if (user.role === 'user') { %>

          <section id="profile-history" hidden>

            <% if (!orders.length) { %>
              <div><h2>No orders yet</h2><p>Completed demo orders will appear here.</p><a href="/cart">Open your cart</a></div>
            <% } %>

            <% for (let order of orders) { %>

              <article>

                <% for (let item of order.items) { %>
                  <div><img src="<%= item.image %>" /><span><%= item.title %></span><strong>$<%= item.price %></strong></div>
                <% } %>

              </article>
            <% } %>

          </section>
        <% } %>
      <% } %>
  </body>
</html>
