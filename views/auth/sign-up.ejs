<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <div class="signup-container">
      <!-- <div class="toggle-container" id="roleToggle">
        <div class="toggle-slider"></div>
        <button type="button" class="toggle-btn active" data-role="user">
          Normal User
        </button>
        <button type="button" class="toggle-btn" data-role="user">
          Photographer
        </button>
      </div> -->
      <div class="form-container-user">
        <h2>Create Your User Account</h2>
        <form action="/auth/sign-up" method="POST" id="signup-form">
          <input type="hidden" name="role" id="active-role" value="user" />
          <div class="form-group">
            <div>
              <label for="username">Username:</label>
              <input
                type="text"
                name="username"
                id="username"
                required
                placeholder="johndoe"
              />
            </div>
            <div>
              <label for="email">Email Address:</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="name@example.com"
              />
            </div>
            <div>
              <label for="firstName">First Name:</label>
              <input
                type="text"
                name="firstName"
                id="firstName"
                placeholder="Hassan"
              />
              <label for="lastName">Last Name:</label>
              <input
                type="text"
                name="lastName"
                id="lastName"
                placeholder="Ali"
              />
            </div>
            <div>
              <label for="password">Password:</label>
              <input
                type="password"
                name="password"
                id="password"
                required
                placeholder="132@34*&"
              />
              <label for="confirmPassword">Confirm Password:</label>
              <input
                type="password"
                name="confirmPassword"
                id="confirmPassword"
                required
                placeholder="132@34*&"
              />
            </div>
          </div>
          <button type="submit" class="submit-btn">Sign Up</button>
        </form>
      </div>
      <div class="form-container-photographer">
        <h2>Create Your Photographer Account</h2>
        <form action="/auth/sign-up" method="POST" id="signup-form">
          <input
            type="hidden"
            name="role"
            id="active-role"
            value="photographer"
          />
          <div class="form-group">
            <div>
              <label for="username">Username:</label>
              <input
                type="text"
                name="username"
                id="username"
                required
                placeholder="johndoe"
              />
            </div>
            <div>
              <label for="email">Email Address:</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="name@example.com"
              />
            </div>
            <div>
              <label for="businessName">Business Name:</label>
              <input
                type="text"
                name="businessName"
                id="businessName"
                placeholder="My Photography Studio"
              />
            </div>
            <div>
              <label for="phoneNumber">Phone Number:</label>
              <input
                type="tel"
                name="phoneNumber"
                id="phoneNumber"
                placeholder="123-456-7890"
              />
            </div>
            <div>
              <label for="address">Address:</label>
              <input
                type="text"
                name="address"
                id="address"
                placeholder="123 Main St"
              />
            </div>
            <div>
              <label for="password">Password:</label>
              <input
                type="password"
                name="password"
                id="password"
                required
                placeholder="132@34*&"
              />
              <label for="confirmPassword">Confirm Password:</label>
              <input
                type="password"
                name="confirmPassword"
                id="confirmPassword"
                required
                placeholder="132@34*&"
              />
            </div>
          </div>
          <button type="submit" class="submit-btn">Sign Up</button>
        </form>
      </div>
    </div>
  </body>
</html>
