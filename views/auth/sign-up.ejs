<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <div class="signup-container">
      <h2>Create Your Account</h2>

      <div class="toggle-container" id="roleToggle">
        <div class="toggle-slider"></div>
        <button type="button" class="toggle-btn active" data-role="user">
          Normal User
        </button>
        <button type="button" class="toggle-btn" data-role="user">
          Photographer
        </button>
      </div>
      <form action="/auth/sign-up" method="POST" id="signup-form">
        <input type="hidden" name="role" id="active-role" value="user" />
        <div class="form-group">
          <label for="username">Username:</label>
          <input
            type="text"
            name="username"
            id="username"
            required
            placeholder="johndoe"
          />
          <label for="email">Email Address:</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            placeholder="name@example.com"
          />
          <label for="password">Password:</label>
          <input
            type="password"
            name="password"
            id="password"
            required
            placeholder="********"
          />
          <label for="confirmPassword">Confirm Password:</label>
          <input
            type="password"
            name="confirmPassword"
            id="confirmPassword"
            required
            placeholder="********"
          />
        </div>
        <div id="user-fields" class="dynamic-fields active">
          <div class="form-group">
            <label for="firstName">First Name:</label>
            <input
              type="text"
              name="firstName"
              id="firstName"
              placeholder="Hassan"
            />
            <label for="lastName">Last Name:</label>
            <input
              type="text"
              name="lastName"
              id="lastName"
              placeholder="Ali"
            />
          </div>
        </div>
        <div id="photographer-fields" class="dynamic-fields">
          <div class="form-group">
            <label for="address">Address:</label>
            <input
              type="text"
              name="address"
              id="address"
              placeholder="123 Main St"
            />
          </div>
        </div>
        <button type="submit" class="submit-btn">Sign Up</button>
      </form>
    </div>
  </body>
</html>
