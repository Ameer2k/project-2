<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign up · Frame</title>
        <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/app.js" defer></script>
  </head>
  <body class="guest-page">
        <%- include('../partials/navbar', { page: 'other' }) %>
    <main class="auth-page signup-page">

      <section class="auth-form">
                <h1>Find your frame.</h1>
        <p class="auth-intro">A new connection starts with you.</p>

                <form action="/auth/sign-up" method="post">
          <fieldset class="role-fieldset">
            <legend>Account type</legend>
                        <div class="role-switch" id="role-switch" data-role="user">
              <span class="role-slider" aria-hidden="true"></span>
              <label><input type="radio" name="role" value="user" checked /> User</label>
              <label><input type="radio" name="role" value="photographer" /> Photographer</label>
            </div>
          </fieldset>
          <div>
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="Choose a username" required />
          </div>
          <div>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required />
          </div>
          <div class="form-row">
            <div>
              <label for="firstName">First name</label>
              <input type="text" id="firstName" name="firstName" placeholder="First name" />
            </div>
            <div>
              <label for="lastName">Last name</label>
              <input type="text" id="lastName" name="lastName" placeholder="Last name" />
            </div>
          </div>
          <fieldset id="photographer-fields" hidden>
            <legend>Photographer details</legend>
            <div>
              <label for="businessName">Business name</label>
              <input type="text" id="businessName" name="businessName" />
            </div>
            <div>
              <label for="phoneNumber">Phone number</label>
              <input type="tel" id="phoneNumber" name="phoneNumber" />
            </div>
            <div>
              <label for="address">Address</label>
              <input type="text" id="address" name="address" />
            </div>
          </fieldset>

                    <div class="form-row">
            <div>
              <label for="password">Password</label>
              <input type="password" id="password" name="password" aria-describedby="password-hint" placeholder="At least 8 characters" required />
            </div>
            <div>
              <label for="confirmPassword">Confirm password</label>
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat your password" required />
            </div>
          </div>
          <small id="password-hint">Use at least 8 characters and matching passwords.</small>
          <button type="submit">Sign up</button>
        </form>

                <p class="auth-bottom">Already have an account? <a href="/auth/sign-in">Sign in</a></p>
      </section>
    </main>
  </body>
</html>
