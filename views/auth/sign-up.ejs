<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <div class="signup-container">
      <!-- <div class="toggle-container" id="roleToggle">
        <div class="toggle-slider"></div>
        <button type="button" class="toggle-btn active" data-role="user">
          Normal User
        </button>
        <button type="button" class="toggle-btn" data-role="user">
          Photographer
        </button>
      </div> -->
      <div>
        <h2>Create Your User Account</h2>
          <fieldset>
            <legend>Account type</legend>
            <div id="role-switch" data-role="user">
              <label><input type="radio" name="role" value="user" checked /> User</label>
              <label><input type="radio" name="role" value="photographer" /> Photographer</label>
            </div>
          </fieldset>
          <div>
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="Choose a username" required />
          </div>
          <div>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required />
          </div>
          <div>
            <div>
              <label for="firstName">First name</label>
              <input type="text" id="firstName" name="firstName" placeholder="First name" />
            </div>
            <div>
              <label for="lastName">Last name</label>
              <input type="text" id="lastName" name="lastName" placeholder="Last name" />
            </div>
          </div>

          <fieldset id="photographer-fields" hidden>
            <legend>Photographer details</legend>
            <div>
              <label for="businessName">Business name</label>
              <input type="text" id="businessName" name="businessName" />
            </div>
            <div>
              <label for="phoneNumber">Phone number</label>
              <input type="tel" id="phoneNumber" name="phoneNumber" />
            </div>
            <div>
              <label for="address">Address</label>
              <input type="text" id="address" name="address" />
            </div>
          </fieldset>

          <div>
            <div>
              <label for="password">Password</label>
              <input type="password" id="password" name="password" placeholder="At least 8 characters" required />
            </div>
            <div>
              <label for="confirmPassword">Confirm password</label>
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat your password" required />
            </div>
          </div>
          <button type="submit">Sign up</button>
        </form>

        <p class="auth-bottom">Already have an account? <a href="/auth/sign-in">Sign in</a></p>
      </section>
  </body>
</html>
